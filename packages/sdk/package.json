{
  "name": "@plimsoll/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Plimsoll coverage ledger and indexer API",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plimsoll-protocol/plimsoll-app.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/plimsoll-protocol/plimsoll-app/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/plimsoll-protocol/plimsoll-app/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "size": "size-limit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.2.1",
    "buffer": "6.0.3",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "@size-limit/file": "12.1.0",
    "@types/node": "22.20.5",
    "size-limit": "12.1.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "size-limit": [
    {
      "name": "@plimsoll/sdk (ESM, gzip)",
      "path": "dist/index.js",
      "limit": "50 KB",
      "gzip": true
    }
  ]
}
