{
  "name": "plimsoll-app",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build -w @plimsoll/sdk && npm run build -w @plimsoll/web",
    "dev": "npm run build -w @plimsoll/sdk && npm run dev -w @plimsoll/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.51.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript-eslint": "8.73.0"
  }
}
